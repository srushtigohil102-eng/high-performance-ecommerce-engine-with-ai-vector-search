MONGO_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=your-super-secret-jwt-key-change-in-production  # required, min 16 chars (server fails fast if missing/short)
REDIS_URL=redis://localhost:6379
PORT=5000
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_MAX=100  # optional, auth requests per 15 min per IP
CLIENT_URL=http://localhost:5173  # optional, base URL used for dev-mode email links logged to console
COOKIE_SECURE=false  # optional, set true when serving HTTPS in production (marks refresh cookie Secure)
TRUST_PROXY=false  # optional, set true when behind a reverse proxy so rate limiting sees real client IPs
OPENAI_API_KEY=sk-your-key-here  # optional, only needed for vector search embeddings

# Gmail SMTP for real email notifications (welcome, order confirmations,
# password reset, order status updates) via Nodemailer.
# IMPORTANT: GMAIL_APP_PASSWORD is a Gmail "App Password" generated at
# https://myaccount.google.com/apppasswords — NOT your regular Gmail password.
# Google blocks plain SMTP logins with the account password by default for
# security; App Passwords require 2-Step Verification enabled on the account.
# Leave both unset in local dev and emails are skipped with a console warning
# instead of failing your request.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# When using Docker Compose, MONGO_URI and REDIS_URL in docker-compose.yml
# override these values to use Docker service names (mongo, redis).
