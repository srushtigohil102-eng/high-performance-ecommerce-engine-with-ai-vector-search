<h2>Hi {{customerName}},</h2>
<p>Thank you for your order! Your order has been confirmed and is being processed.</p>

<div style="background: #f5f5f5; padding: 15px; border-radius: 5px; margin: 20px 0;">
  <p><strong>Order Number:</strong> #{{orderNumber}}</p>
  <p><strong>Order Date:</strong> {{orderDate}}</p>
  <p><strong>Status:</strong> <span style="display:inline-block;padding:5px 15px;border-radius:20px;background:#4caf50;color:white;font-size:14px;">{{status}}</span></p>
</div>

<h3>Order Items</h3>
<table style="width:100%;border-collapse:collapse;margin:20px 0;">
  <thead>
    <tr style="background:#1a237e;color:white;">
      <th style="padding:10px;text-align:left;">Product</th>
      <th style="padding:10px;text-align:center;">Qty</th>
      <th style="padding:10px;text-align:right;">Price</th>
      <th style="padding:10px;text-align:right;">Total</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr style="border-bottom:1px solid #eee;">
      <td style="padding:10px;">{{this.product.name}}</td>
      <td style="padding:10px;text-align:center;">{{this.quantity}}</td>
      <td style="padding:10px;text-align:right;">${{this.price}}</td>
      <td style="padding:10px;text-align:right;">${{multiply this.price this.quantity}}</td>
    </tr>
    {{/each}}
    <tr style="font-weight:bold;border-top:2px solid #1a237e;">
      <td colspan="3" style="padding:10px;text-align:right;">Total</td>
      <td style="padding:10px;text-align:right;">${{totalAmount}}</td>
    </tr>
  </tbody>
</table>

<div style="margin-top:30px;padding:20px;background:#f9f9f9;border-radius:5px;">
  <h4>📦 Shipping Address</h4>
  <p>
    {{shippingAddress.fullName}}<br>
    {{shippingAddress.address}}<br>
    {{shippingAddress.city}}, {{shippingAddress.state}} {{shippingAddress.pincode}}<br>
    {{shippingAddress.country}}<br>
    Phone: {{shippingAddress.phone}}
  </p>
</div>

<div style="text-align:center;margin-top:30px;">
  <a href="{{clientUrl}}/orders/{{orderId}}" class="button">View Order</a>
</div>

<p style="margin-top:30px;color:#666;">
  We'll notify you when your order ships. If you have any questions, please contact our support team.
</p>