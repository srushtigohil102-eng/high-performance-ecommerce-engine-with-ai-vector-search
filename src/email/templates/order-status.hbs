<h2>Hi {{customerName}},</h2>
<p>Your order #{{orderNumber}} has been updated.</p>

<div style="text-align:center;padding:20px;background:#f5f5f5;border-radius:10px;margin:20px 0;">
  <span style="font-size:48px;display:block;margin-bottom:10px;">{{statusIcon}}</span>
  <span style="display:inline-block;padding:8px 25px;border-radius:25px;color:white;font-size:18px;font-weight:bold;background:{{statusColor}};">
    {{status}}
  </span>
  <p style="margin-top:15px;">{{statusMessage}}</p>
</div>

<div style="text-align:center;margin-top:30px;">
  <a href="{{clientUrl}}/orders/{{orderId}}" class="button">View Order</a>
</div>

<p style="margin-top:30px;color:#666;">
  {{footerMessage}}
</p>